---
/** `/tags/<tag>/` — entries across lanes carrying the tag, newest first. */
import Base from '../../layouts/Base.astro';
import EntryRow from '../../components/EntryRow.astro';
import { getAllTags, getEntries } from '../../lib/content';
import { getAlternates } from '../../lib/alternates';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({ params: { tag } }));
}
const { tag } = Astro.params;
const entries = (await getEntries()).filter((e) => e.tags.includes(tag!));
---

<Base title={`#${tag}`} description={`Everything tagged ${tag}.`} alternates={getAlternates({ kind: 'site' })}>
  <div class="container page">
    <header class="page-head">
      <p class="mono crumb"><a href="/tags/">Tags</a> <span aria-hidden="true">/</span> {tag}</p>
      <h1 class="h-display">{tag}</h1>
      <p class="intro">{entries.length} {entries.length === 1 ? 'entry' : 'entries'} across every lane.</p>
    </header>
    <div class="list">
      {entries.map((e, i) => <EntryRow entry={e} dense showLane last={i === entries.length - 1} />)}
    </div>
  </div>
</Base>

<style>
  .page { padding-top: 72px; padding-bottom: 80px; display: flex; flex-direction: column; gap: 36px; }
  .crumb { margin: 0; }
  .list { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  @media (max-width: 640px) { .page { padding-top: 36px; padding-bottom: 40px; gap: 24px; } }
</style>
