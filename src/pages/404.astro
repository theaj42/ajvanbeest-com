---
/** Custom 404 in the site's style (SPEC B10). */
import Base from '../layouts/Base.astro';
import { LANES, LANE_LABEL } from '../lib/content';
---

<Base title="Not found" description="That page doesn't exist.">
  <div class="container page">
    <p class="mono">404</p>
    <h1 class="h-display title">Nothing grows here.</h1>
    <p class="intro">That page doesn't exist, or it moved. Try one of the lanes.</p>
    <nav class="lanes" aria-label="Lanes">
      {LANES.map((l) => <a href={`/${l}/`} class="nav-link">{LANE_LABEL[l]} →</a>)}
    </nav>
  </div>
</Base>

<style>
  .page { padding-top: 96px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 18px; }
  .title { font-size: 56px; line-height: 1.05; font-style: italic; }
  .intro { margin: 0; font-size: 20px; max-width: 640px; color: var(--fg-muted); }
  .lanes { display: flex; gap: 28px; flex-wrap: wrap; margin-top: 12px; }
  .lanes a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); }
  @media (max-width: 640px) { .page { padding-top: 48px; padding-bottom: 48px; } .title { font-size: 40px; } }
</style>
