---
/** Light/dark toggle. A real button with a 44px hit area; flips data-theme and persists to localStorage.theme. */
interface Props { class?: string }
const { class: cls } = Astro.props;
---

<button type="button" class:list={['theme-toggle', cls]} data-theme-toggle aria-label="Switch to dark theme">
  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
</button>

<style>
  .theme-toggle { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--fg-muted); border-radius: 4px; }
  .theme-toggle:hover { color: var(--accent); }
  .moon { display: none; }
  :global(:root[data-theme="dark"]) .sun { display: none; }
  :global(:root[data-theme="dark"]) .moon { display: block; }
</style>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  function label() {
    const dark = root.dataset.theme === 'dark';
    buttons.forEach((b) => b.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme'));
  }
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      label();
      document.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
    }),
  );
  label();
</script>
